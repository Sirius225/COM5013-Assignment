
#tests whether Python can handle integers larger than 64 bits

# Maximum unsigned 64-bit integer
max_64_bit = (2 ** 64) - 1

#creates a number larger than the 64-bit limit
large_number = max_64_bit + 1

#creates an even larger number
very_large_number = 2 ** 100

print("Maximum unsigned 64-bit value:", max_64_bit)
print("Number above 64-bit limit:", large_number)
print("A 100-bit integer:", very_large_number)

#checks whether Python handles these numbers correctly
print("\n===== TEST RESULTS =====")

if large_number > max_64_bit:
    print("64-bit boundary test: PASSED")

if very_large_number == 2 ** 100:
    print("100-bit integer test: PASSED")

#tests storing and retrieving a large integer in a dictionary
number_lookup = {}

number_lookup["large_value"] = very_large_number

if number_lookup["large_value"] == very_large_number:
    print("Large integer dictionary test: PASSED")
